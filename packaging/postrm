#!/bin/sh
set -e
if [ "$1" = remove ]; then
    deb-systemd-helper mask m45-drive-watcher-collector.timer >/dev/null || true
fi
if [ "$1" = purge ]; then
    deb-systemd-helper purge m45-drive-watcher-collector.timer >/dev/null || true
    deb-systemd-helper unmask m45-drive-watcher-collector.timer >/dev/null || true
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
