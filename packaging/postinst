#!/bin/sh
set -e
if [ "$1" = configure ]; then
    deb-systemd-helper unmask drivewatch-collector.timer >/dev/null || true
    # Default on for new installs; preserve administrator-disabled timers on upgrade.
    if deb-systemd-helper --quiet was-enabled drivewatch-collector.timer; then
        deb-systemd-helper enable drivewatch-collector.timer >/dev/null || true
    else
        deb-systemd-helper update-state drivewatch-collector.timer >/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        deb-systemd-invoke start drivewatch-collector.timer || true
    fi
fi
# Desktop sessions pick up the global autostart entry at next login.
